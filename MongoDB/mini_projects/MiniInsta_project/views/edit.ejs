<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="bg-red-600 text-sm text-center mb-2 w-40 px-3 py-2 rounded-md p-5 block " href="/logout">Logout</a>
        </div>


        <h5 class="mb-5">Edit Your Post</h5>


        <form action="/update/<%= post._id %>" method="post">
            <textarea class=" w-1/3 resize-none bg-transparent border-2  outline-none border-xinc-800 rounded-md block text-center" name="content" placeholder="What's on your mind"><%= post.content %></textarea>
            <input type="submit" value="Update Post" class="text-sm mt-2 w-40 px-3 py-2 text-black font-black bg-yellow-600 rounded-md p-5 block">
        </form>
    </div>
    
</body>
</html>