<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="bg-red-600 text-sm text-center mb-2 w-40 px-3 py-2 rounded-md p-5 block " href="/logout">Logout</a>
        </div>



        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-md ">
                <img 
                    class="w-full h-full object-cover rounded-md" 
                    src="/images/uploads/<%= user.profilepic %>" 
                    alt="Profile Pic">
            </div>
            <h3 class="text-3xl mb-5 "><span class="font-light">Hello,</span> <%= user.name %> ✌ </h3>
        </div>

        <h5 class="mb-5 mt-3">You can create new post.</h5>


        <form action="/post" method="post">
            <textarea class=" w-1/3 resize-none bg-transparent border-2  outline-none border-xinc-800 rounded-md block text-center" name="content" placeholder="What's on your mind"></textarea>
            <input type="submit" value="Create Post" class="text-sm mt-2 w-40 px-3 py-2 bg-blue-600 rounded-md p-5 block">
        </form>

        <div class="post mt-20">
            <h3 class="text-zinc-400">Your Posts.</h3>
            <div class="postcontainer mt-5">

                 <% user.posts.reverse().forEach((post) => {%>
                    <div class="post mb-5 w-1/2 p-4 border-[1px] border-zinc-200  rounded-md">
                    <h4 class="text-blue-500 mb-2 ">@<%= user.username %></h4>
                    <p class="tracking-tight text-sm"><%= post.content %></p>

                        <!-- LIKES -->
                    <small class="mt-4 inline-block"><%= post.likes.length %> likes</small>


                    <div class="btns flex gap-4 mt-1">
                        <a href="/like/<%= post._id %>" class="text-blue-500"><%= post.likes.indexOf(user._id) ? "Like" : "Unlike" %></a><a>
                        <a href="/edit/<%= post._id %>" class="text-zinc-600">Edit</a>
                    </div>
                </div>
               <% }); %>


                
                
            </div>
        </div>
    </div>
    
</body>
</html>