<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task App</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-800">

    <div class="main w-full min-h-screen p-10">

        <!-- Form Section -->
        <div class="form text-white">
            <form action="/create" method="post">

                <input 
                    class="block w-full rounded-md px-5 py-2 bg-zinc-700 outline-none"
                    type="text"
                    name="title"
                    placeholder="Title goes here"
                >

                <textarea 
                    class="block w-full rounded-md mt-2 px-5 py-2 bg-zinc-700 resize-none outline-none"
                    name="details"
                    placeholder="Write your description here!"
                ></textarea>

                <input 
                    class="mt-2 bg-blue-600 px-5 py-2 rounded-md cursor-pointer"
                    type="submit"
                    value="Create Task"
                >

            </form>
        </div>

        <!-- Task Section -->
        <div class="tasks flex gap-3 flex-wrap mt-10">

            <% if(files.length > 0){ %>

                <% files.forEach(function(val){ %>

                    <div class="task bg-zinc-700 w-72 rounded-md p-5">

                        <h1 class="text-white text-2xl tracking-tight">
                            <%= val %>
                        </h1>

                        <a href="/file/<%= val %>" class="text-blue-400 inline-block mt-3">
                            Read More
                        </a>

                    </div>

                <% }) %>

            <% } else { %>

                <h3 class="text-zinc-300 text-xl">
                    No Tasks Yet
                </h3>

            <% } %>

        </div>

    </div>

</body>

</html>