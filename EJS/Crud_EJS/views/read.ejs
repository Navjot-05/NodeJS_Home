<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="stylesheets/style.css">
</head>

<body>
    <div class="w-full min-h-full bg-zinc-800 p-10">
        <a class="text-blue-500 mt-10" href="/">Back to Home</a>
        <h1 class="text-3xl tracking-tighter mb-3">All User</h1>
        <div class="users flex gap-3 flex-wrap">
            <% if(users.length> 0){ %>
                <% users.forEach((user)=> { %>
                    <div class="user w-60 p-4 bg-zinc-700 rounded-lg">
                        <div class="w-full h-72 bg-zinc-600 rounded-lg"><img
                                class="w-full h-full object-contain object-center" src=<%=user.image %> ></div>
                        <h3 class="text-xl mt-3 tracking-tighter ">
                            <%= user.name %>
                        </h3>
                        <h5 class="text-zinc-600">
                            <%= user.email %>
                        </h5>
                        <div class="flex gap-3">
                            <a class="text-yellow-300" href=/edit/<%= user._id%>>Edit User</a>
                            <a class="text-red-600" href=/delete/<%=user._id%>>Delete User</a>
                        </div>
                    </div>
                    <% }); %>
                        <%}else{%>
                            <h3 class="text-yellow-600 text-3xl font-bold tracking-tighter">No Users Yet !!</h3>
                        <%}%>
        </div>
    </div>

</body>

</html>