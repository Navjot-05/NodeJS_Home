<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="stylesheets/style.css">
</head>

<body>
    <div class="w-full h-full bg-zinc-800 p-10">
        <div class="nav mb-10">
            <a class="text-blue-500" href="/read">Read Users</a>

        </div>
        <form action="/create" method="post">
            <h1 class="text-3xl tracking-tighter mb-3">Create User</h1>
            <input 
            name="name"
            class="px-5 py-2 border-2 border-zinc-800 rounded-lg bg-transparent text-white" 
            placeholder="name"
            type="text">


            <input 
            name="email"
            class="px-5 py-2 border-2 border-zinc-800 rounded-lg bg-transparent text-white" 
            type="text"
            placeholder="email">


            <input 
            name="image"
            class="px-5 py-2 border-2 border-zinc-800 rounded-lg bg-transparent text-white" 
            type="text"
            placeholder="image">

            <input class="px-5 py-2 bg-blue-500 rounded-lg ml-10" type="submit" value="Create User">
        </form>
    </div>

</body>

</html>